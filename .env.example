# ==============================================================================
# SaaS-O-Matic — Environment Configuration Template
# ==============================================================================

# Application Environment Mode (development | production | test)
NODE_ENV=development

# Backend API Service
PORT=3000
DATABASE_NAME=saas_o_matic.sqlite

# Frontend Web Service
FRONTEND_PORT=4200

# Docker Production Settings
DOCKER_BACKEND_PORT=3000
DOCKER_FRONTEND_PORT=80
DOCKER_SQLITE_PATH=/app/data/saas_o_matic.sqlite
